{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "77code",
  "compatibility_date": "2026-11-21",
  // Só arquivos estáticos (dist/), sem código de Worker por enquanto.
  // Rota inexistente: status 404 com a página public/404.html (nunca a home disfarçada).
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": true,
  // Domínios próprios: o deploy cria o registro DNS. Não pode existir outro registro A/AAAA/CNAME
  // com esses nomes na zona (os da Vercel precisam sair antes).
  "routes": [
    { "pattern": "77code.com.br", "custom_domain": true },
    { "pattern": "www.77code.com.br", "custom_domain": true }
  ]
}
