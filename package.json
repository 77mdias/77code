{
  "name": "77code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5177",
    "build": "vite build",
    "preview": "vite preview --port 4177 --strictPort",
    "test:e2e": "playwright test",
    "test": "node --test tests/*.test.mjs tests/*.test.ts tests/worker/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "cf:dev": "vite build && wrangler dev --port 8778 --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/reggae-one": "5.3.1",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
